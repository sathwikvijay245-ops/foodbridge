# FoodBridge Environment Configuration (HACK-P197)

# Database URL
# Default SQLite (Zero setup out-of-the-box):
DATABASE_URL=sqlite:///./food_donation.db

# Or PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql://postgres:password123@localhost:5432/foodbridge_db

# Security & JWT
SECRET_KEY=hack-p197-super-secret-key-foodbridge-2026-secure-jwt
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256
